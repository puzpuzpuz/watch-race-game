}

.score-label {
  left: 44px;
  top: 36px;
}

.kmh {
  left: 96px;
  top: 92px;
}

.pump {
  position: absolute;
  left: 260px;
  top: 36px;
  width: 24px;
  height: 24px;
}

.km {
  left: 202px;
  top: 480px;
}

.boost {
  position: absolute;
  left: 264px;
  top: 444px;
  width: 104px;
  height: 48px;
}

.dim {
  position: absolute;
  left: 0px;
