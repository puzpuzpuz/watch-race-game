}

.res-distance {
  left: 166px;
  top: 230px;
}

.res-km {
  left: 244px;
  top: 256px;
}

.res-best {
  left: 190px;
  top: 300px;
}

/* The best run's distance, under the best score. */
.res-best-km {
  left: 244px;
  top: 354px;
}

.res-new {
  left: 166px;
  top: 392px;
}

.res-tap {
  left: 142px;
