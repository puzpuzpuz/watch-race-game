<template>
  <!-- The watch has no z-index: page order is drawing order. -->
  <stack class="page" ontouchstart="tapPage">
    <image class="sky" src="/common/assets/bg/bg_sky.png"></image>
    <image class="city" src="/common/assets/bg/bg_city.png" style="{{cityStyle}}"></image>
    <image id="road" class="road" src="{{roadSrc}}"></image>
    <image for="{{back}}" tid="k" class="obj" src="{{$item.src}}" style="{{$item.s}}" show="{{$item.on}}"></image>
    <div id="carg" class="carg" style="{{carStyle}}">
      <div id="carj" class="carj">
        <image class="car" src="{{carSrc}}" show="{{carOn}}"></image>
        <image class="flame" src="{{flameSrc}}" show="{{flameOn}}"></image>
        <image class="smoke" src="{{smokeSrc}}" show="{{smokeOn}}"></image>
        <image class="spark" src="{{sparkSrc}}" show="{{sparkOn}}"></image>
      </div>
    </div>
    <image for="{{front}}" tid="k" class="obj" src="{{$item.src}}" style="{{$item.s}}" show="{{$item.on}}"></image>
    <image id="popup" class="obj" src="{{popSrc}}" style="{{popStyle}}" show="{{popOn}}"></image>

    <image class="hud score-label" src="/common/assets/hud/words_score.png"></image>
    <image for="{{score}}" tid="k" class="digit" src="{{$item.src}}" style="{{$item.s}}"></image>
    <image for="{{speed}}" tid="k" class="digit" src="{{$item.src}}" style="{{$item.s}}"></image>
    <image class="hud kmh" src="/common/assets/hud/words_kmh.png"></image>
    <image class="pump" src="/common/assets/hud/hud_icons_0.png"></image>
    <image for="{{fuel}}" tid="k" class="gauge" src="{{$item.src}}" style="{{$item.s}}"></image>
    <image for="{{lives}}" tid="k" class="heart" src="{{$item.src}}" style="{{$item.s}}"></image>
    <image for="{{dist}}" tid="k" class="digit" src="{{$item.src}}" style="{{$item.s}}"></image>
    <image class="hud km" src="/common/assets/hud/words_km.png"></image>
    <image class="boost" src="{{boostSrc}}"></image>
    <image class="obj" src="{{headSrc}}" style="{{headStyle}}" show="{{headOn}}"></image>

    <div class="dim" show="{{paused}}"></div>
    <image class="hud paused" src="/common/assets/hud/words_paused.png" show="{{paused}}"></image>
    <image class="hud tap-go" src="/common/assets/hud/words_taptogo.png" show="{{paused}}"></image>

    <block if="{{view === 'title'}}">
      <image class="full" src="/common/assets/screens/title_bg.jpg"></image>
      <image class="logo" src="/common/assets/screens/logo.png"></image>
      <image class="hud title-best" src="/common/assets/hud/words_best.png"></image>
      <image for="{{titleBest}}" tid="k" class="digit" src="{{$item.src}}" style="{{$item.s}}"></image>
      <image class="hud title-tap" src="/common/assets/hud/words_taptostart.png" show="{{tapOn}}"></image>
      <image if="{{debug}}" class="full" src="/common/assets/screens/corners.png"></image>
      <text if="{{debug}}" class="info">{{build}}</text>
    </block>

    <block if="{{view === 'results'}}">
      <image class="full" src="/common/assets/screens/results_bg.jpg"></image>
      <image class="obj" src="{{resHeadSrc}}" style="{{resHeadStyle}}"></image>
      <image class="hud res-score" src="/common/assets/hud/words_score.png"></image>
      <image for="{{resScore}}" tid="k" class="digit" src="{{$item.src}}" style="{{$item.s}}"></image>
      <image class="hud res-distance" src="/common/assets/hud/words_distance.png"></image>
      <image for="{{resDist}}" tid="k" class="digit" src="{{$item.src}}" style="{{$item.s}}"></image>
      <image class="hud res-km" src="/common/assets/hud/words_km.png"></image>
      <image class="hud res-best" src="/common/assets/hud/words_best.png"></image>
      <image for="{{resBest}}" tid="k" class="digit" src="{{$item.src}}" style="{{$item.s}}"></image>
      <image for="{{resBestDist}}" tid="k" class="digit" src="{{$item.src}}" style="{{$item.s}}"></image>
      <image class="hud res-best-km" src="/common/assets/hud/words_km.png" show="{{resBestKmOn}}"></image>
      <image class="hud res-new" src="/common/assets/hud/words_newbest.png" show="{{newBestOn}}"></image>
      <image class="hud res-tap" src="/common/assets/hud/words_taptostart.png" show="{{tapOn}}"></image>
    </block>

    <block if="{{view === 'load'}}">
      <div class="cover"></div>
      <image class="logo load-logo" src="/common/assets/screens/logo.png"></image>
    </block>

    <text if="{{debug && view === 'race'}}" class="fps">{{fpsText}}</text>

    <!-- Taps land here, on top of everything, unless a block shown by `if`
         ends up above it; then they bubble up to the page instead. -->
    <div class="catch" ontouchstart="tapLayer"></div>
  </stack>
</template>

<script>
import storage from '@system.storage'
import BUILD from '../../common/js/buildinfo.js'
import { DEBUG } from '../../common/js/config.js'
import { initialData } from '../../common/js/renderer.js'
import { Runner } from '../../common/js/runner.js'

// The page is a thin host: the game, its loop and the renderer live in
// common/js and run the same in the desktop harness.

// Both are optional: without Folme the car moves by its style instead.
let folme = null
let brightness = null
try {
  folme = require('@system.folme')
} catch (e) {
  folme = null
}
try {
  brightness = require('@system.brightness')
} catch (e) {
  brightness = null
}
const BEST_KEY = 'bestScore'

function loadBest(done) {
  storage.get({
    key: BEST_KEY,
    success: (data) => done(data),
    fail: () => done(null)
  })
}

function saveBest(value) {
  storage.set({ key: BEST_KEY, value: value })
}

function keepScreenOn(on) {
  if (brightness && typeof brightness.setKeepScreenOn === 'function') {
    brightness.setKeepScreenOn({ keepScreenOn: on })
  }
}

// The first touch point's position: clientX and clientY of changedTouches as
// documented, falling back to touches, the event itself and other names.
const POINT_KEYS = [['clientX', 'clientY'], ['pageX', 'pageY'], ['globalX', 'globalY'], ['localX', 'localY'], ['x', 'y']]

function touchPoint(evt) {
  if (!evt) return null
  const candidates = [first(evt.changedTouches), first(evt.touches), evt]
  for (const t of candidates) {
    if (!t) continue
    for (const [kx, ky] of POINT_KEYS) {
      if (typeof t[kx] === 'number' && typeof t[ky] === 'number') return { x: t[kx], y: t[ky] }
    }
  }
  return null
}

function first(list) {
  return (list && list[0]) || null
}

export default {
  private: Object.assign(initialData(), { debug: DEBUG, build: BUILD }),

  onInit() {
    this.runner = new Runner({
      vm: this,
      folme: folme && typeof folme.to === 'function' ? folme : null,
      loadBest: loadBest,
      saveBest: saveBest,
      keepScreenOn: keepScreenOn
    })
  },

  onReady() {
    this.runner.start()
  },

  onShow() {
    this.runner.show()
  },

  // Leaving the app or turning the screen off pauses the race.
  onHide() {
    this.runner.hide()
  },

  // Clears the loop timer, as Xiaomi's memory guide asks.
  onDestroy() {
    this.runner.destroy()
  },

  // touchstart fires earlier than click, which matters for dodging. The tap
  // layer and the page both listen, so a tap counts whichever element the
  // watch delivers it to; when both see it, the second call is dropped.
  tapLayer(evt) {
    this.tapped(evt, 'layer')
  },

  tapPage(evt) {
    this.tapped(evt, 'page')
  },

  tapped(evt, via) {
    const p = touchPoint(evt)
    // Without a position the tap still starts a run; in a race it steers left.
    const x = p ? Math.round(p.x) : -1
    const y = p ? Math.round(p.y) : -1
    const now = Date.now()
    if (now - this.tapAt < 80 && x === this.tapX && y === this.tapY) return
    this.tapAt = now
    this.tapX = x
    this.tapY = y
    this.runner.touch(x, y)
    // Debug builds show the last tap under the build name on the title.
    if (DEBUG) this.build = BUILD + ' tap ' + (p ? x + ',' + y : '?') + ' ' + via
  }
}
</script>

<style>
.page {
  width: 432px;
  height: 514px;
  background-color: #03070d;
}

.sky {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 432px;
  height: 190px;
}

/* 1296 px: the tile, its mirror and the tile again; slides by its style. */
.city {
  position: absolute;
  left: 0px;
  top: 80px;
  width: 1296px;
  height: 110px;
}

/* Half-resolution frames shown at 2x. */
.road {
  position: absolute;
  left: 0px;
  top: 190px;
  width: 432px;
  height: 324px;
  object-fit: fill;
}

/* Sprites, words and headlines keep each picture's own size. */
.obj,
.hud {
  position: absolute;
}

/* The car group: Folme slides it between lanes (translateX) and the inner
   group jolts on hits (translateY). The car sits at y 360-440. */
.carg {
  position: absolute;
  left: 144px;
  top: 330px;
  width: 144px;
  height: 124px;
}

.carj {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 144px;
  height: 124px;
}

